# Copy this file to .env and fill in your own values. Never commit .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
TOKEN_TTL_SECONDS=28800

# Notification destinations
ALERT_EMAIL=your-recipient@gmail.com
ALERT_PHONE=+919XXXXXXXXX

# Gmail SMTP (use a Google App Password, NOT your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=replace-with-16-character-google-app-password
SMTP_FROM=your-sender@gmail.com
SMTP_USE_SSL=false

# MSG91 SMS Flow API (sender ID is configured on the approved MSG91 template)
# Template must contain variables VAR1, VAR2, VAR3, VAR4
MSG91_AUTHKEY=replace-with-msg91-authkey
MSG91_TEMPLATE_ID=replace-with-approved-flow-template-id
MSG91_API_URL=https://control.msg91.com/api/v5/flow

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
